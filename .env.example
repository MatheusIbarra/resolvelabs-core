# Conexão com o MongoDB
MONGODB_URI=mongodb://127.0.0.1:27018/resolvehub

# Segredo para assinar os JWTs (mínimo 32 caracteres). Gere com: openssl rand -base64 48
JWT_SECRET=

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
# Segredo do endpoint de webhook. Local: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=
# URL pública do app (usada nos redirecionamentos do checkout). Padrão: origem da requisição.
APP_URL=
